PUBLIC_BRAND_NAME=DealHunter
APP_NAME=DealHunter API
ADMIN_API_TOKEN=dev-admin-token
DATABASE_URL=postgresql+psycopg://dealhunter:dealhunter@localhost:5432/dealhunter
REDIS_URL=redis://localhost:6379/0
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
FEATURE_LLM_INTENT_PARSER=false
LLM_INTENT_PARSER_MODE=disabled
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_INTENT_TIMEOUT_SECONDS=10
FEATURE_AI_ROUTER=false
AI_ROUTER_MODE=disabled
AI_ROUTER_DEFAULT_MODEL=intent-parser-v0
AI_ROUTER_STRATEGY=cost_optimized
AI_ROUTER_FALLBACK_PROVIDER=openai
AI_ROUTER_CACHE_ENABLED=true
AI_ROUTER_CACHE_TTL_SECONDS=300
ANTHROPIC_API_KEY=
ANTHROPIC_INTENT_MODEL=claude-3-5-haiku-latest
ANTHROPIC_INTENT_TIMEOUT_SECONDS=10
FEATURE_BANDIT_ROUTER=false
BANDIT_ROUTER_MODE=disabled
BANDIT_EPSILON=0.1
BANDIT_ALPHA=0.5
BANDIT_MIN_SAMPLES_READY=10
BANDIT_REWARD_ALPHA=0.5
BANDIT_REWARD_BETA=0.3
BANDIT_REWARD_GAMMA=0.2
BANDIT_REWARD_DELTA=0.0
FEATURE_PERSONALIZATION=false
PERSONALIZATION_CACHE_ENABLED=true
PERSONALIZATION_CACHE_TTL_SECONDS=300
FEATURE_CHINESE_LLM_PROVIDERS=false
DEEPSEEK_API_KEY=
DEEPSEEK_INTENT_MODEL=deepseek-chat
DEEPSEEK_INTENT_TIMEOUT_SECONDS=10
DASHSCOPE_API_KEY=
QWEN_INTENT_MODEL=qwen-plus
QWEN_INTENT_TIMEOUT_SECONDS=10
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
ERNIE_INTENT_MODEL=ernie-speed-128k
ERNIE_INTENT_TIMEOUT_SECONDS=10
BANDIT_POLICY=linucb
FEATURE_NEURAL_BANDIT=false
FEATURE_RLHF_ROUTER=false
FEATURE_LLM_USER_EMBEDDING=false
FEATURE_BAYESIAN_TUNING=false
FEATURE_AUTO_TUNING=false
FEATURE_KILL_SWITCH=false
AUTO_TUNE_DRY_RUN=true
AUTO_TUNE_CANARY_ENABLED=false
CANARY_ENABLED=false
CANARY_PERCENTAGE=0
CANARY_FEATURES=router,bandit,personalization,llm_cn
CANARY_STICKY_SESSION=true
FEATURE_ABTEST_ENABLED=false
ABTEST_CONFIG_PATH=config/abtest.yaml
ABTEST_REDIS_TTL=2592000
